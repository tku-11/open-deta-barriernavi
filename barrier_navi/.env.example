# MySQL 接続設定
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_a_secure_password
MYSQL_DATABASE=station

# Flask セッション署名鍵
# 48文字以上のランダム値を設定してください。Gitへコミットしないでください。
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# ローカルHTTP開発では false、本番HTTPSでは true
SESSION_COOKIE_SECURE=false

# 同一オリジン運用では空のままにします。
# 別オリジンのフロントエンドを許可する場合だけ、https://app.example.com のようにカンマ区切りで指定します。
CORS_ALLOWED_ORIGINS=

# Flask 実行設定
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ローカル単体起動では memory://、Docker本番構成では redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://
